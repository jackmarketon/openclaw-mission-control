#!/bin/bash
set -e

SKILL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SERVER_DIR="$SKILL_DIR/server"
PID_FILE="/tmp/mission-control.pid"
LOG_FILE="/tmp/mission-control.log"
PORT="${MISSION_CONTROL_PORT:-3030}"

case "${1:-}" in
  start)
    if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
      echo "Mission Control is already running (PID $(cat "$PID_FILE"))"
      exit 0
    fi
    
    echo "Starting Mission Control..."
    cd "$SERVER_DIR"
    nohup node index.js > "$LOG_FILE" 2>&1 &
    echo $! > "$PID_FILE"
    sleep 1
    
    if kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
      echo "✓ Mission Control started on http://localhost:$PORT"
      echo "  View logs: mission-control logs"
      echo "  Open dashboard: mission-control open"
    else
      echo "✗ Failed to start. Check logs: mission-control logs"
      rm -f "$PID_FILE"
      exit 1
    fi
    ;;
    
  stop)
    if [ ! -f "$PID_FILE" ]; then
      echo "Mission Control is not running"
      exit 0
    fi
    
    PID=$(cat "$PID_FILE")
    if kill -0 "$PID" 2>/dev/null; then
      echo "Stopping Mission Control (PID $PID)..."
      kill "$PID"
      rm -f "$PID_FILE"
      echo "✓ Stopped"
    else
      echo "Process not found, cleaning up stale PID file"
      rm -f "$PID_FILE"
    fi
    ;;
    
  status)
    if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
      PID=$(cat "$PID_FILE")
      echo "Mission Control is running (PID $PID)"
      echo "Dashboard: http://localhost:$PORT"
    else
      echo "Mission Control is not running"
      [ -f "$PID_FILE" ] && rm -f "$PID_FILE"
      exit 1
    fi
    ;;
    
  logs)
    if [ -f "$LOG_FILE" ]; then
      tail -f "$LOG_FILE"
    else
      echo "No logs found. Has Mission Control been started?"
      exit 1
    fi
    ;;
    
  open)
    if ! command -v xdg-open &> /dev/null && ! command -v open &> /dev/null; then
      echo "Cannot detect browser opener (xdg-open or open)"
      echo "Open manually: http://localhost:$PORT"
      exit 1
    fi
    
    if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
      echo "Opening dashboard in browser..."
      if command -v xdg-open &> /dev/null; then
        xdg-open "http://localhost:$PORT" 2>/dev/null &
      else
        open "http://localhost:$PORT" 2>/dev/null &
      fi
    else
      echo "Mission Control is not running. Start it first:"
      echo "  mission-control start"
      exit 1
    fi
    ;;
    
  *)
    echo "Mission Control - OpenClaw session dashboard"
    echo ""
    echo "Usage:"
    echo "  mission-control start    Start the dashboard server"
    echo "  mission-control stop     Stop the server"
    echo "  mission-control status   Check if running"
    echo "  mission-control open     Open dashboard in browser"
    echo "  mission-control logs     View server logs"
    echo ""
    exit 1
    ;;
esac
